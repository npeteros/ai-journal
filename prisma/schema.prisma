// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?           @db.Timestamptz
  sessions           Session[]
  accounts           Account[]
  aiUsageLogs        AiUsageLog[]
  entries            Entry[]
  tags               Tag[]
  frameworks         Framework[]
  insightReport      InsightReport?
  personalityProfile PersonalityProfile?
  monthlyStories     MonthlyStory[]
  dailyPrompts       DailyPrompt[]
  profile            UserProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent        String
  model        String
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  success      Boolean
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage_log")
}

model Entry {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  frameworkId String?        @db.Uuid
  framework   Framework?     @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  title       String
  body        String
  writtenAt   DateTime       @default(now()) @db.Timestamptz
  entryDate   DateTime       @db.Date
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz
  deletedAt   DateTime?      @db.Timestamptz
  tags        EntryTag[]
  analysis    EntryAnalysis?

  @@index([userId, writtenAt])
  @@index([userId, entryDate])
  @@map("entry")
}

/// Matches `moods` in src/lib/design-tokens/colors.ts.
enum Mood {
  calm
  grateful
  tired
  anxious
  hard
}

model EntryAnalysis {
  entryId       String   @id @db.Uuid
  entry         Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mood          Mood
  /// 0–100, higher = better.
  moodScore     Int
  summary       String[]
  themes        String[]
  suggestedTags String[]
  /// Hash of the body that was analyzed; re-analysis is skipped when it matches.
  bodyHash      String
  model         String
  analyzedAt    DateTime @db.Timestamptz

  @@map("entry_analysis")
}

model InsightReport {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart       DateTime? @db.Date
  periodEnd         DateTime? @db.Date
  recurringThemes   Json      @default("[]")
  growthSuggestions Json      @default("[]")
  trendCaption      String?
  entryCount        Int       @default(0)
  model             String?
  generatedAt       DateTime? @db.Timestamptz
  generatingAt      DateTime? @db.Timestamptz
  lastRefreshAt     DateTime? @db.Timestamptz
  lastError         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  @@map("insight_report")
}

model PersonalityProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  traits       Json      @default("[]")
  summary      String?
  meaning      String?
  basedOn      Int       @default(0)
  model        String?
  generatedAt  DateTime? @db.Timestamptz
  generatingAt DateTime? @db.Timestamptz
  retryAfter   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@map("personality_profile")
}

model MonthlyStory {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String
  summary      String?
  model        String?
  generatedAt  DateTime? @db.Timestamptz
  fingerprint  String?
  generatingAt DateTime? @db.Timestamptz
  failedAt     DateTime? @db.Timestamptz
  lastError    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@unique([userId, month])
  @@map("monthly_story")
}

model DailyPrompt {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The user's local day, stored as UTC midnight (like Entry.entryDate).
  day          DateTime  @db.Date
  text         String?
  /// Number of analyzed entries the prompt was generated from.
  sourceCount  Int?
  model        String?
  generatedAt  DateTime? @db.Timestamptz
  generatingAt DateTime? @db.Timestamptz
  failedAt     DateTime? @db.Timestamptz
  lastError    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@unique([userId, day])
  @@map("daily_prompt")
}

model Tag {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  createdAt      DateTime   @default(now()) @db.Timestamptz
  updatedAt      DateTime   @updatedAt @db.Timestamptz
  deletedAt      DateTime?  @db.Timestamptz
  entries        EntryTag[]

  @@unique([userId, normalizedName])
  @@map("tag")
}

model EntryTag {
  entryId   String   @db.Uuid
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId     String   @db.Uuid
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([entryId, tagId])
  @@index([tagId])
  @@map("entry_tag")
}

model Framework {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  description String
  minutes     Int
  icon        String
  prompts     Json
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  entries     Entry[]
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  @@index([userId])
  @@map("framework")
}

enum CompanionTone {
  GENTLE
  DIRECT
  PLAYFUL
}

// Onboarding answers and first-run state. Answers are injected into Jaden's prompts;
// resetting onboarding nulls the timestamps (never delete the row).
model UserProfile {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusAreas        String[]       @default([])
  focusAreaOther    String?        @db.VarChar(80)
  goal              String?        @db.VarChar(280)
  currentContext    String?        @db.VarChar(500)
  preferredTone     CompanionTone?
  welcomeAnsweredAt DateTime?      @db.Timestamptz
  welcomeSkippedAt  DateTime?      @db.Timestamptz
  tourCompletedAt   DateTime?      @db.Timestamptz
  tourDismissedAt   DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  @@map("user_profile")
}
