# Copy this file to `.env` and replace the placeholders with your real values.
# Requires PostgreSQL >= 15.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only, used by the app at runtime).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations — never the 6543 transaction pooler).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public origin used for canonical URLs, OG images, robots.txt and sitemap.xml.
# Falls back to Vercel's production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Better Auth variables
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OpenAI key used by Mastra agents and `npm run eval`
OPENAI_API_KEY=

# AI observability & guardrails
# Log prompts/completions in traces (keep false in production)
AI_LOG_CONTENT=false
# Per-user AI rate limit: max calls per rolling window
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT_MAX_CALLS=50
# Voice journaling sessions (GPT-Live) have their own budget, outside the limit above.
VOICE_SESSION_WINDOW_SECONDS=86400
VOICE_SESSION_MAX=3
# Background monthly Story summaries have their own budget, outside the shared limit.
MONTHLY_STORY_WINDOW_SECONDS=86400
MONTHLY_STORY_MAX_CALLS=20
# Writing companion questions (/journal/companion) have their own budget, outside the shared limit.
WRITING_COMPANION_WINDOW_SECONDS=86400
WRITING_COMPANION_MAX_CALLS=30
# Comma-separated user IDs (e.g. a demo account) exempt from the limits above. Calls are still logged.
AI_RATE_LIMIT_EXEMPT_USER_IDS=
# debug | info | warn | error | silent
LOG_LEVEL=info