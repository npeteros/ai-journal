# Copy this file to `.env` and replace the placeholders with your real values.
# Requires PostgreSQL >= 15.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only, used by the app at runtime).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations — never the 6543 transaction pooler).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Better Auth variables
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OpenAI key used by Mastra agents and `npm run eval`
OPENAI_API_KEY=

# AI observability & guardrails
# Log prompts/completions in traces (keep false in production)
AI_LOG_CONTENT=false
# Per-user AI rate limit: max calls per rolling window
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT_MAX_CALLS=50
# debug | info | warn | error | silent
LOG_LEVEL=info
